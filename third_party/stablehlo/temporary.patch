+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Defines the `lit_test_suite` macro."""
+
+load("//third_party/llvm/build_defs:lit.bzl", "lit_test")
+
+def lit_test_suite(
+        name,
+        srcs,
+        size_of_suite = "medium",
+        size_per_test = "small",
+        data = None,
+        tags = None,
+        args = None):
+    """
+    Defines a `lit_test` for each file in `srcs`; wraps them in a `test_suite`.
+
+    Args:
+      name: The name of the test suite.
+      srcs: The list/glob of `.mlir` LIT test files included in the test suite.
+      size_of_suite: The size of the test suite as a whole.
+      size_per_test: The size of the individual tests comprising the suite.
+      data: List of labels for the test's data dependencies (i.e. runtime deps).
+      tags: List of tags to attach to the tests.
+      args: List of extra arguments to pass to the test driver.
+    """
+
+    if data is None:
+        data = []
+    if tags is None:
+        tags = []
+    if args is None:
+        args = []
+
+    tests_in_suite = []
+
+    for src in srcs:
+        test_name = "%s.test" % src
+        lit_test(
+            name = test_name,
+            # copybara:uncomment srcs = [src],
+            src = src,  # copybara:comment
+            args = args,
+            data = data + glob(
+                ["%s.bc" % src],
+                # Allow empty since not all `.mlir` tests have `.mlir.bc` files.
+                allow_empty = True,
+            ),
+            # copybara:uncomment deps = ["@rules_python//python/runfiles"],
+            driver = "//third_party/llvm/llvm-project/mlir:run_lit.sh",  # copybara:comment
+            tags = tags,
+            size = size_per_test,
+        )
+        tests_in_suite.append(test_name)
+
+    test_suite(
+        name = name,
+        tests = tests_in_suite,
+        size = size_of_suite,
+    )
